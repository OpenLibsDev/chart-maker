  "inst_s7_t": "键盘快捷键",
  "inst_s7_b": "<ul><li><b>Ctrl/Cmd + Z</b> — 撤销</li><li><b>Ctrl/Cmd + Y</b> 或 <b>Ctrl/Cmd + Shift + Z</b> — 重做</li><li><b>Ctrl/Cmd + S</b> — 保存项目</li><li><b>Ctrl/Cmd + E</b> — 导出窗口</li><li><b>Ctrl/Cmd + O</b> — 导入窗口</li><li><b>Ctrl/Cmd + J</b> — 日志</li><li><b>Ctrl/Cmd + ,</b> — 设置</li></ul><p class=\"mb-0\">在输入框内，Ctrl+Z 和 Ctrl+Y 作为普通文本编辑使用。</p>",
  "inst_s8_t": "撤销与日志",
